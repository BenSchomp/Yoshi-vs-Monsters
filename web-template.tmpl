    <script type="application/javascript">

    // Touch controls. The page handles every touch itself, so they work anywhere on screen,
    // including the grey space around the game. Wherever a finger lands becomes the
    // joystick's center, and dragging away from it moves Yoshi that way, in 8 directions
    // including diagonals. A quick tap works like "any key", and two quick taps pause.
    // The game reads window.touchControls every frame (see TouchControls in yoshi.py).
    const JOYSTICK_RADIUS = 50         // how far the knob travels, in screen pixels
    const DEAD_ZONE = 10               // smaller drags don't move Yoshi
    const DIAGONAL_SHARE = 0.38        // sin(22.5 degrees): splits the circle into 8 equal directions
    const TAP_MAX_MS = 250             // a shorter touch, without dragging, is a tap
    const DOUBLE_TAP_GAP_MS = 350
    window.touchControls = { left: 0, right: 0, up: 0, down: 0, taps: 0, doubleTaps: 0 }
    let joystickTouch = null           // the finger driving the joystick; other fingers are ignored
    let lastTapEndedAt = -Infinity
    const joystickRing = document.getElementById("joystick")

    function findJoystickTouch(event) {
        if (!joystickTouch) return null
        return Array.from(event.changedTouches).find(touch => touch.identifier === joystickTouch.id) || null
    }

    function setJoystickDirections(left, right, up, down) {
        Object.assign(touchControls, { left: +left, right: +right, up: +up, down: +down })
    }

    window.addEventListener("touchstart", event => {
        event.preventDefault()   // no scrolling, zooming or emulated mouse clicks
        event.stopPropagation()  // the game sees touches only through touchControls
        if (joystickTouch) return
        const touch = event.changedTouches[0]
        joystickTouch = { id: touch.identifier, centerX: touch.clientX, centerY: touch.clientY,
                          startedAt: performance.now(), draggedPastDeadZone: false }
        joystickRing.style.left = touch.clientX + "px"
        joystickRing.style.top = touch.clientY + "px"
        moveJoystickKnob(0, 0)
        joystickRing.style.display = "block"
    }, { capture: true, passive: false })

    function moveJoystickKnob(offsetX, offsetY) {
        document.getElementById("joystick-knob").style.transform = `translate(${offsetX}px, ${offsetY}px)`
    }

    window.addEventListener("touchmove", event => {
        event.preventDefault()
        event.stopPropagation()
        const touch = findJoystickTouch(event)
        if (!touch) return
        const offsetX = touch.clientX - joystickTouch.centerX
        const offsetY = touch.clientY - joystickTouch.centerY
        const distance = Math.hypot(offsetX, offsetY)
        if (distance <= DEAD_ZONE) {
            setJoystickDirections(false, false, false, false)
        } else {
            joystickTouch.draggedPastDeadZone = true
            setJoystickDirections(offsetX / distance < -DIAGONAL_SHARE, offsetX / distance > DIAGONAL_SHARE,
                                  offsetY / distance < -DIAGONAL_SHARE, offsetY / distance > DIAGONAL_SHARE)
        }
        const knobScale = distance > JOYSTICK_RADIUS ? JOYSTICK_RADIUS / distance : 1
        moveJoystickKnob(offsetX * knobScale, offsetY * knobScale)
    }, { capture: true, passive: false })

    function endJoystickTouch(event) {
        event.preventDefault()
        event.stopPropagation()
        if (!findJoystickTouch(event)) return
        const now = performance.now()
        const wasTap = !joystickTouch.draggedPastDeadZone && now - joystickTouch.startedAt < TAP_MAX_MS
        if (wasTap && joystickTouch.startedAt - lastTapEndedAt < DOUBLE_TAP_GAP_MS) {
            touchControls.doubleTaps += 1
            lastTapEndedAt = -Infinity   // a third tap starts over
        } else if (wasTap) {
            touchControls.taps += 1
            lastTapEndedAt = now
        } else {
            lastTapEndedAt = -Infinity
        }
        joystickTouch = null
        setJoystickDirections(false, false, false, false)
        joystickRing.style.display = "none"
    }
    window.addEventListener("touchend", endJoystickTouch, { capture: true, passive: false })
    window.addEventListener("touchcancel", endJoystickTouch, { capture: true, passive: false })

